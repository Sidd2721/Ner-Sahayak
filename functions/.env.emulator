# Firebase Local Emulator Suite — environment for functions/ tests and local dev.
# These vars are picked up automatically by firebase-admin when set in the
# process environment; firebase.json's emulators block sets them when running
# via `firebase emulators:start`. For direct `npm test` runs, tsx loads this
# file via the test helpers in test/helpers/emulator.ts.
#
# Ports match firebase.json's emulators config exactly.

FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Project ID must match .firebaserc's default project.
GCLOUD_PROJECT=sih2026-ce822
FIREBASE_CONFIG={"projectId":"sih2026-ce822","storageBucket":"sih2026-ce822.firebasestorage.app"}
